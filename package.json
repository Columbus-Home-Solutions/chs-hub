{
  "name": "chs-hub",
  "version": "0.1.0",
  "description": "Columbus Home Solutions operational hub — Cloudflare Worker backend + static docs",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create chs-hub-db",
    "db:migrate:local": "wrangler d1 migrations apply chs-hub-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply chs-hub-db --remote",
    "db:execute": "wrangler d1 execute chs-hub-db --remote --command",
    "r2:create": "wrangler r2 bucket create chs-hub-files",
    "tail": "wrangler tail",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250410.0",
    "typescript": "^5.4.5",
    "wrangler": "^4.85.0"
  }
}
